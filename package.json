{
  "name": "chat-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:client": "bun run --cwd packages/client build",
    "start:server": "bun run --cwd packages/server src/index.ts",
    "dev:server": "bun run --cwd packages/server dev",
    "dev:client": "bun run --cwd packages/client dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-schema": "bun run --cwd packages/protocol scripts/generate-schema.ts && prettier --write packages/protocol/from-{client,server}.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "prettier": "^3.6.2"
  }
}
